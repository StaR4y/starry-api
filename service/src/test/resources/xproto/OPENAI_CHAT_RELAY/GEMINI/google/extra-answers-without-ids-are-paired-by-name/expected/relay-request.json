{
  "path": "/v1/chat/completions",
  "headers": {
    "accept": "text/event-stream, application/json",
    "authorization": "Bearer <relay key>",
    "content-type": "application/json"
  },
  "body": {
    "model": "relay-gemini",
    "messages": [
      {
        "role": "system",
        "content": "You are an interactive CLI agent specializing in software engineering tasks. Your primary goal is to help users safely and efficiently, adhering strictly to the following instructions and utilizing your available tools. [shortened]"
      },
      {
        "role": "user",
        "content": "Run two commands"
      },
      {
        "role": "assistant",
        "content": "I will run both.",
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "run_shell_command",
              "arguments": "{\"command\":\"echo first\"}"
            },
            "extra_content": {
              "google": {
                "thought_signature": "skip_thought_signature_validator"
              }
            }
          },
          {
            "id": "call_2",
            "type": "function",
            "function": {
              "name": "run_shell_command",
              "arguments": "{\"command\":\"echo second\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": "{\"output\":\"first\\n\"}",
        "tool_call_id": "call_1"
      },
      {
        "role": "tool",
        "content": "{\"output\":\"second\\n\"}",
        "tool_call_id": "call_2"
      }
    ],
    "max_tokens": 4096,
    "temperature": 1,
    "top_p": 0.95,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "run_shell_command",
          "description": "This tool executes a given shell command as `bash -c <command>`. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "Exact bash command to execute"
              },
              "description": {
                "type": "string",
                "description": "Brief description of the command"
              },
              "directory": {
                "type": "string",
                "description": "Directory to run the command in"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "Reads and returns the content of a specified file. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "absolute_path": {
                "type": "string",
                "description": "The absolute path to the file"
              },
              "offset": {
                "type": "number"
              },
              "limit": {
                "type": "number"
              }
            },
            "required": [
              "absolute_path"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "write_file",
          "description": "Writes content to a specified file in the local filesystem. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "file_path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "file_path",
              "content"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "replace",
          "description": "Replaces text within a file. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "file_path": {
                "type": "string"
              },
              "old_string": {
                "type": "string"
              },
              "new_string": {
                "type": "string"
              },
              "expected_replacements": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": [
              "file_path",
              "old_string",
              "new_string"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "list_directory",
          "description": "Lists the names of files and subdirectories directly within a specified directory path. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "dir_path": {
                "type": "string"
              },
              "ignore": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "dir_path"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "glob",
          "description": "Efficiently finds files matching specific glob patterns. [shortened]",
          "parameters": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  }
}

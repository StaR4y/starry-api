{
  "path": "/v1/chat/completions",
  "headers": {
    "accept": "text/event-stream, application/json",
    "authorization": "Bearer <relay key>",
    "content-type": "application/json"
  },
  "body": {
    "model": "relay-sonnet",
    "messages": [
      {
        "role": "system",
        "content": "You are an interactive CLI agent specializing in software engineering tasks. Your primary goal is to help users safely and efficiently, adhering strictly to the following instructions and utilizing your available tools. [shortened]"
      },
      {
        "role": "user",
        "content": "Reply with the single word ok"
      }
    ],
    "max_tokens": 4096,
    "temperature": 1,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "response",
        "schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            }
          },
          "required": [
            "answer"
          ]
        }
      }
    },
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  }
}

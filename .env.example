HOST_BIND_ADDR=0.0.0.0
SERVER_PORT=8080
HOST_HTTP_PORT=18080

POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap-password
POSTGRES_MIGRATION_PASSWORD=change-me-migration-password
POSTGRES_PASSWORD=change-me-application-password
POSTGRES_SSL_MODE=disable
POSTGRES_SHM_SIZE=256mb
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_AUTOVACUUM_WORK_MEM=64MB
POSTGRES_AUTOVACUUM_MAX_WORKERS=4
POSTGRES_AUTOVACUUM_NAPTIME=30s
POSTGRES_DEFAULT_STATISTICS_TARGET=200
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MIN_WAL_SIZE=512MB
POSTGRES_MAX_WAL_SIZE=2GB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_TRACK_IO_TIMING=on
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=5min
POSTGRES_POOL_INITIAL_SIZE=4
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_POOL_MAX_ACQUIRE_TIME=5s
POSTGRES_POOL_MAX_CREATE_CONNECTION_TIME=5s
POSTGRES_POOL_MAX_LIFE_TIME=2h
POSTGRES_PREPARED_STATEMENT_CACHE_QUERIES=256
POSTGRES_STATEMENT_TIMEOUT=PT2M
POSTGRES_LOCK_WAIT_TIMEOUT=PT5S
FLYWAY_ENABLED=true
FLYWAY_CONNECT_RETRIES=10
SPRING_CODEC_MAX_IN_MEMORY_SIZE=16MB

STARRY_MAX_IMPORT_BYTES=268435456
STARRY_DATA_TRANSFER_PROCESS_TIMEOUT=30m
# Persist this file's entire owner-only directory, including the generated
# initialization marker. Data-management security supports one active service instance.
# STARRY_DATA_MANAGEMENT_SECURITY_FILE=/absolute/persistent/security/data-management.json
STARRY_DATA_MANAGEMENT_REQUIRE_INITIALIZED=false
# Emergency use only. Set this to a writable owner-only file containing the
# original data-management key, then unset it after the service consumes it.
STARRY_DATA_MANAGEMENT_RECOVERY_KEY_FILE=
STARRY_PAYMENT_RECONCILIATION_INTERVAL=PT30S
STARRY_PAYMENT_RECONCILIATION_INITIAL_DELAY=PT30S
STARRY_PAYMENT_PROVIDER_RECONCILIATION_INTERVAL=PT30S
STARRY_PAYMENT_PROVIDER_RECONCILIATION_INITIAL_DELAY=PT45S
STARRY_MODEL_PRICING_REMOTE_REFRESH_ENABLED=true
STARRY_MODEL_PRICING_SYNC_CATALOG_IDS=false
STARRY_MODEL_PRICING_SOURCE_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.json
STARRY_MODEL_PRICING_CHECKSUM_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.sha256
STARRY_MODEL_PRICING_REFRESH_INTERVAL=PT10M
STARRY_MODEL_PRICING_MAX_CATALOG_BYTES=4194304
STARRY_MODEL_PRICING_DIR=
STARRY_STATS_AGGREGATION_ENABLED=true
STARRY_STATS_AGGREGATION_INTERVAL=PT1M
STARRY_STATS_AGGREGATION_INITIAL_DELAY=PT30S
STARRY_STATS_AGGREGATION_MAX_ADVANCE_HOURS=1
STARRY_STATS_AGGREGATION_LOOKBACK_HOURS=6
STARRY_STATS_AGGREGATION_MAX_BATCHES_PER_RUN=6
STARRY_STATS_MAINTENANCE_CRON="0 25 3 * * *"
STARRY_STATS_PARTITION_MONTHS_AHEAD=12
STARRY_STATS_RAW_RETENTION_MONTHS=4
STARRY_STATS_RAW_DEFAULT_DELETE_BATCH_SIZE=10000
STARRY_STATS_RAW_DEFAULT_DELETE_MAX_BATCHES=20
STARRY_STATS_HOURLY_RETENTION_DAYS=90
STARRY_STATS_HOURLY_DELETE_BATCH_SIZE=10000
STARRY_STATS_HOURLY_DELETE_MAX_BATCHES=20
STARRY_STATS_USAGE_EVENT_RETENTION_DAYS=400
STARRY_STATS_USAGE_EVENT_DELETE_BATCH_SIZE=10000
STARRY_STATS_USAGE_EVENT_DELETE_MAX_BATCHES=100
STARRY_ACCOUNT_ALLOCATION_MAINTENANCE_ENABLED=true
STARRY_ACCOUNT_ALLOCATION_MAINTENANCE_CRON="0 35 * * * *"
STARRY_ACCOUNT_ALLOCATION_LEASE_RETENTION_DAYS=7
STARRY_ACCOUNT_ALLOCATION_EVENT_RETENTION_DAYS=90
STARRY_ACCOUNT_ALLOCATION_DELETE_BATCH_SIZE=10000
STARRY_ACCOUNT_ALLOCATION_DELETE_MAX_BATCHES=20

KIRO_ALLOW_ANONYMOUS_PROXY=false
KIRO_ADMIN_SESSION_TTL=12h
KIRO_RATE_LIMIT_PER_MINUTE=120
KIRO_ACCOUNT_SELECTION_STRATEGY=round_robin
KIRO_REQUEST_TIMEOUT=300s
KIRO_MAX_RETRIES=2
KIRO_BASE_COOLDOWN=60s
KIRO_QUOTA_RESET=1h
KIRO_PROBABILISTIC_RETRY=0.1
KIRO_MAX_REQUEST_BODY_BYTES=10485760
KIRO_SESSION_AFFINITY_ENABLED=true
KIRO_SESSION_AFFINITY_TTL=10m
KIRO_SESSION_AFFINITY_MAXIMUM_SIZE=100000
KIRO_WEBUI_URL=https://your-domain.example/#/login
KIRO_TOKEN_REFRESH_INTERVAL_MS=3600000
KIRO_TOKEN_REFRESH_INITIAL_DELAY_MS=60000
KIRO_PREFERRED_ENDPOINT=codewhisperer

# Optional. Prefer local admin login unless you need a static emergency token.
# KIRO_ADMIN_TOKEN=change-me-admin-token

# JVM memory budget. Keep the heap well below the container limit (SERVICE_MEM_LIMIT, default 2g): heap + direct
# buffers + metaspace + threads must fit. ExitOnOutOfMemoryError makes the container restart instead of hanging.
# The small -Xms and the G1 periodic collection let the JVM hand memory back after a burst instead of keeping it.
JAVA_OPTS="-Xms64m -Xmx768m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError -XX:G1PeriodicGCInterval=300000 -XX:-G1PeriodicGCInvokesConcurrent -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30"
# SERVICE_MEM_LIMIT=2g
# Emergency kill switch only. Developer mode is enabled through root password + email verification.
STARRY_PLUGINS_DISABLED=false
# STARRY_PLUGIN_DIR=/var/lib/starry-api/plugins
